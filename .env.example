# ---- Supabase ----------------------------------------------------------
# Project Settings -> Data API  (URL + anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project Settings -> API Keys -> the "secret" key (sb_secret_...), which is the
# counterpart to the publishable key above. Not the legacy service_role JWT.
# SERVER ONLY. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Google Gemini -----------------------------------------------------
# https://aistudio.google.com/apikey -> Create API key. Free tier is enough.
# SERVER ONLY — never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key

# Model used for workout plans, diet plans, the coach and macro estimates.
#
# gemini-3.5-flash-lite is the default because of quota, not quality. On a free
# key the full Flash models are capped at 20 requests A DAY per model, which one
# onboarding plus a short coach conversation exhausts. Flash-lite is limited
# per-minute (15) instead, which an app can actually live within.
#
# With billing enabled, gemini-3.6-flash writes noticeably better plans.
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- App ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
